<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Cho phép truy cập trực tiếp đến file PHP
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# Cho phép truy cập tất cả file PHP
<Files "*.php">
    Require all granted
</Files>

# Cấu hình khác
Options -Indexes